@page "/"
@page "/login"
@using Microsoft.EntityFrameworkCore
@using BitFlipBlazor.Data
@using BitFlipBlazor.Models
@using BitFlipBlazor.Services
@inject AppDbContext Db
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Bit-Flip Login</PageTitle>

<div class="min-h-screen flex flex-col justify-center items-center pb-24 bg-[#0D1117] text-white select-none">
    <img src="bitflip_logo.png" class="max-w-[150px] mb-5 drop-shadow-[0_0_12px_rgba(0,229,255,0.3)]" alt="Bit-Flip Logo" />
    <p class="text-[#00E5FF] tracking-[2px] font-bold mb-5 text-sm uppercase">LOG IN</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="w-[300px] mb-4 p-2.5 rounded bg-red-950/60 border border-red-500/50 text-red-400 text-xs text-center transition-all animate-shake">
            @errorMessage
        </div>
    }

    <div class="w-[300px] flex flex-col gap-3.5">
        <input type="email" 
               class="w-full bg-[#f0ece2] text-black px-4 py-3 rounded-md outline-none text-sm transition-all duration-200 focus:ring-2 focus:ring-[#00E5FF] focus:bg-white placeholder:text-gray-500" 
               placeholder="Email (School Email)" 
               @bind="email" 
               disabled="@isProcessing" />

        <input type="password" 
               class="w-full bg-[#f0ece2] text-black px-4 py-3 rounded-md outline-none text-sm transition-all duration-200 focus:ring-2 focus:ring-[#00E5FF] focus:bg-white placeholder:text-gray-500" 
               placeholder="Password" 
               @bind="password" 
               @onkeydown="HandleKeyDown"
               disabled="@isProcessing" />

        <button type="button" 
                class="w-full py-3 mt-1 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 ease-out hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.5)] hover:-translate-y-0.5 active:translate-y-0 active:scale-95 disabled:opacity-50 disabled:pointer-events-none cursor-pointer" 
                @onclick="HandleLogin" 
                disabled="@isProcessing">
            @(isProcessing ? "AUTHENTICATING..." : "Log In")
        </button>
    </div>

    <p class="text-xs mt-6 text-[#8B949E]">
        Don't Have An Account?        
        <button type="button" 
                class="text-[#00E5FF] font-semibold hover:underline cursor-pointer transition-colors hover:text-white ml-1" 
                @onclick='() => Nav.NavigateTo("/register")'>
            Register
        </button>
    </p>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool isProcessing = false;

    private async Task HandleLogin()
    {
        if (isProcessing) return;

        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Invalid Email or Password";
            return;
        }

        try
        {
            isProcessing = true;

            var trimmedEmail = email.Trim().ToLower();
            var user = await Db.Users
                .FirstOrDefaultAsync(u => u.Email.ToLower() == trimmedEmail && u.Password == password && u.IsActive == 1);

            if (user != null)
            {
                Session.SetUser(user.Uid, user.Name, user.Role);
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = "Invalid Email or Password";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login error: {ex.InnerException?.Message ?? ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }
}
