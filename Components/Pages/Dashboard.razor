@page "/dashboard"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using BitFlipBlazor.Data
@using BitFlipBlazor.Models
@using BitFlipBlazor.Services
@inject AppDbContext Db
@inject UserSession Session
@inject NavigationManager Nav

<style>
    /* Direct styles from dashboard.php */
    .top-nav-tabs { display: flex; gap: 30px; border-bottom: 1px solid #30363d; margin-bottom: 30px; }
    .nav-tab { padding: 15px 5px; color: #8B949E; text-decoration: none; font-weight: bold; font-size: 16px; border-bottom: 3px solid transparent; cursor: pointer; }
    .nav-tab:hover { color: white; }
    .nav-tab.active { color: var(--neon-teal); border-bottom-color: var(--neon-teal); }
    
    .sub-nav { display: flex; gap: 15px; margin-bottom: 25px; padding: 5px 0; }
    .sub-tab { 
        font-size: 12px; color: #8B949E; text-decoration: none; padding: 8px 20px; 
        border-radius: 30px; border: 1px solid #30363d; transition: 0.3s;
        font-weight: bold; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;
    }
    .sub-tab:hover { border-color: var(--neon-teal); color: white; }
    .sub-tab.active { background: rgba(0, 229, 255, 0.1); color: var(--neon-teal); border-color: var(--neon-teal); }

    .admin-card { background-color: var(--card-bg); border: 1px solid #30363d; border-radius: 12px; padding: 25px; }
    .red-top { border-top: 3px solid #ef4444; }
    .cyan-top { border-top: 3px solid var(--neon-teal); }
    .blue-top { border-top: 3px solid #3b82f6; }
    .orange-top { border-top: 3px solid #ffaa00; }
    .status-tag { background: #441111; color: #ff4444; padding: 8px 20px; border-radius: 8px; border: 1px solid #ff4444; font-size: 12px; font-weight: bold; text-transform: uppercase; }

    .grid-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 25px; }
    .class-card { background: var(--card-bg); border-radius: 15px; border: 1px solid #30363d; overflow: hidden; transition: 0.3s; cursor: pointer; }
    .class-card:hover { transform: translateY(-5px); border-color: var(--neon-teal); }
    .card-banner { height: 120px; display: flex; align-items: center; justify-content: center; font-size: 50px; }
    .mission-row { background: var(--card-bg); border-radius: 12px; padding: 20px; display: flex; align-items: center; margin-bottom: 15px; border-left: 6px solid #4ade80; }
    .stat-circle { width: 65px; height: 65px; border: 4px solid #30363d; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 9px; margin-left: 15px; text-align: center; }
    .stat-circle b { font-size: 13px; color: white; }

    .admin-table { width: 100%; border-collapse: collapse; text-align: left; color: white; }
    .admin-table th { padding: 15px; color: #8B949E; font-size: 13px; text-transform: uppercase; background: #1c2128; }
    .admin-table td { padding: 15px; border-top: 1px solid #30363d; }
    .badge { padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; }
    .role-student { background: var(--neon-teal); color: black; }
    .role-professor { background: #3b82f6; color: white; }
    .role-admin { background: #ef4444; color: white; }
    .control-btn { padding: 6px 15px; border-radius: 4px; text-decoration: none !important; font-size: 11px; font-weight: bold; cursor: pointer; display: inline-block; }
    .btn-green { background: #114411; color: #44ff44; border: 1px solid #44ff44; margin-right: 5px; }
    .btn-red { background: #441111; color: #ff4444; border: 1px solid #ff4444; }

    .modal { display: flex; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 1000; align-items: center; justify-content: center; }
</style>

<div style="padding: 30px 60px; max-width: 1300px; margin: auto;">
    
    <!-- HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; width: 100%;">
        <div>
            <h1 style="margin:0; font-size: 24px;">SYSTEM: DASHBOARD</h1>
            <p style="color: var(--text-gray); font-size: 14px;">
                Agent: @Session.Name | <span class="badge role-@Session.Role.ToLower()">@Session.Role</span>
            </p>
        </div>
        <div class="header-right">
            <button class="neon-btn btn-terminate" @onclick="TerminateSession">TERMINATE SESSION</button>
        </div>  
    </div>

    <!-- MAIN NAVIGATION TABS -->
    <div class="top-nav-tabs">
        @if (Session.Role == "ADMIN")
        {
            <a href="dashboard?view=main" class="nav-tab @(CurrentView == "main" ? "active" : "")">System Overview</a>
            <a href="dashboard?view=users" class="nav-tab @(CurrentView == "users" ? "active" : "")">User Directory</a>
            <a href="dashboard?view=archive" class="nav-tab @(CurrentView == "archive" ? "active" : "")">User Archive</a>
        }
        else
        {
            <a href="dashboard?view=main" class="nav-tab @(CurrentView == "main" || CurrentView == "missions" ? "active" : "")">Classes</a>
            @if (Session.Role == "STUDENT")
            {
                <a href="dashboard?view=extra" class="nav-tab @(CurrentView == "extra" ? "active" : "")">Badges</a>
            }
        }
    </div>

    <!-- ========================================================================= -->
    <!--                               ADMIN VIEWS                                 -->
    <!-- ========================================================================= -->
    @if (Session.Role == "ADMIN")
    {
        @if (CurrentView == "main")
        {
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px;">
                <div>
                    <h2 style="margin:0; color: white;">System Administration</h2>
                    <p style="color: #ef4444; font-weight: bold; letter-spacing: 1px;">ROOT ACCESS: @Session.Name</p>
                </div>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <div class="status-tag">SYSTEM STATUS: STABLE</div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                <div class="admin-card red-top">
                    <p style="font-size: 11px; color: #8B949E; margin: 0;">TOTAL SYSTEM USERS</p>
                    <h2 style="font-size: 40px; margin: 15px 0; color: white;">@totalUsers</h2>
                    <p style="font-size: 11px; color: #8B949E;">Active Personnel</p>
                </div>
                <div class="admin-card cyan-top">
                    <p style="font-size: 11px; color: #8B949E; margin: 0;">ACTIVE STUDENTS</p>
                    <h2 style="font-size: 40px; margin: 15px 0; color: white;">@totalStudents</h2>
                    <p style="font-size: 11px; color: var(--neon-teal);">Live Players Only</p>
                </div>
                <div class="admin-card blue-top">
                    <p style="font-size: 11px; color: #8B949E; margin: 0;">GLOBAL SUCCESS RATE</p>
                    <h2 style="font-size: 40px; margin: 15px 0; color: white;">@globalSuccessRate%</h2>
                    <p style="font-size: 11px; color: #8B949E;">Pass Rate Percentage</p>
                </div>
            </div>
        }
        else if (CurrentView == "users")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <p style="color: #8B949E; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; margin: 0;">
                    AGENT DIRECTORY (Total: @FilteredUsers.Count())
                </p>
                <input type="text" class="search-input" placeholder="SEARCH AGENTS..." @bind="searchTerm" @bind:event="oninput" />
            </div>

            <div class="sub-nav">
                @foreach (var f in new[] { "ALL", "STUDENT", "PROFESSOR", "ADMIN" })
                {
                    <a href="dashboard?view=users&filter=@f" class="sub-tab @(Filter == f ? "active" : "")">@f</a>
                }
            </div>

            <div class="admin-card" style="padding: 0; overflow: hidden;">
                <table class="admin-table">
                    <tr style="background: #1c2128;">
                        <th>UID</th><th>Name</th><th>Email</th><th>Access</th><th style="text-align:center;">Control</th>
                    </tr>
                    @if (FilteredUsers.Any())
                    {
                        @foreach (var u in FilteredUsers)
                        {
                            <tr>
                                <td style="color: #8B949E;">#@u.Uid</td>
                                <td><b>@u.Name</b></td>
                                <td style="color: #8B949E;">@u.Email</td>
                                <td><span class="badge role-@u.Role.ToLower()">@u.Role</span></td>
                                <td style="text-align: center;">
                                    <button class="control-btn btn-red" @onclick="() => ToggleUserStatus(u.Uid, 0)">ARCHIVE</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="padding:40px; text-align:center; color:#8B949E;">No agents found.</td></tr>
                    }
                </table>
            </div>
        }
        else if (CurrentView == "archive")
        {
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <p style="color: #8B949E; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; margin: 0;">
                    TERMINATED AGENT LOGS (Total: @archivedUsersList.Count)
                </p>
            </div>

            <div class="admin-card orange-top" style="padding: 0; overflow: hidden;">
                <table class="admin-table">
                    <tr style="background: #1c2128;">
                        <th>UID</th><th>Name</th><th>Email</th><th>Role</th><th style="text-align:center;">Control</th>
                    </tr>
                    @if (archivedUsersList.Any())
                    {
                        @foreach (var u in archivedUsersList)
                        {
                            <tr>
                                <td style="color: #8B949E;">#@u.Uid</td>
                                <td><b>@u.Name</b></td>
                                <td style="color: #8B949E;">@u.Email</td>
                                <td><span class="badge role-@u.Role.ToLower()">@u.Role</span></td>
                                <td style="text-align: center;">
                                    <button class="control-btn btn-green" @onclick="() => ToggleUserStatus(u.Uid, 1)">RESTORE</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="padding:40px; text-align:center; color:#8B949E;">No archived accounts found.</td></tr>
                    }
                </table>
            </div>
        }
    }

    <!-- ========================================================================= -->
    <!--                      STUDENT & PROFESSOR VIEWS                            -->
    <!-- ========================================================================= -->
    else
    {
        @if (CurrentView == "main" || string.IsNullOrEmpty(CurrentView))
        {
            <h3 style="color: #8B949E; margin-bottom: 25px;">Active Classes</h3>
            <div class="grid-container">
                @foreach (var sec in userSections)
                {
                    <div class="class-card" @onclick='() => Nav.NavigateTo($"dashboard?view=missions&sid={sec.Sid}")'>
                        <div class="card-banner" style="background:@(sec.Sid % 2 == 0 ? "#fce4ec" : "#e0f7fa");">👨‍💻</div>
                        <div style="padding:20px;">
                            <div style="font-weight:bold; font-size:18px;">@sec.SectionName</div>
                            <div style="font-size:12px; color:#8B949E; margin-top:5px;">AY 25-26</div>
                            <div style="font-size:11px; color:var(--neon-teal); margin-top:10px;">ID: #@sec.Sid | Code: @sec.SectionPassword</div>
                        </div>
                    </div>
                }

                <div class="class-card" style="border:2px dashed #30363d; display:flex; flex-direction:column; align-items:center; justify-content:center; height:230px;" 
                     @onclick="() => showActionModal = true">
                    <div style="font-size:30px; color:#8B949E;">+</div>
                    <b style="color:#8B949E;">@(Session.Role == "PROFESSOR" ? "Create section" : "Join class")</b>
                </div>
            </div>
        }
        else if (CurrentView == "missions" && Sid.HasValue)
        {
            <div style="display:flex; align-items:center; margin-bottom: 25px;">
                <a href="dashboard?view=main" class="control-btn btn-red" style="width:auto; margin-right:20px; padding: 10px 20px;">« BACK</a>
                <h2 style="margin:0;">@(currentSection?.SectionName ?? "Mission Hub")</h2>
            </div>

            <div class="sub-nav">
                @if (Session.Role == "PROFESSOR")
                {
                    <a href="dashboard?view=missions&sid=@Sid&sub=ongoing" class="sub-tab @(SubView == "ongoing" ? "active" : "")">CHALLENGES</a>
                    <a href="dashboard?view=missions&sid=@Sid&sub=roster" class="sub-tab @(SubView == "roster" ? "active" : "")">STUDENT ROSTER</a>
                }
                else
                {
                    <a href="dashboard?view=missions&sid=@Sid&sub=ongoing" class="sub-tab @(SubView == "ongoing" ? "active" : "")">ONGOING</a>
                    <a href="dashboard?view=missions&sid=@Sid&sub=completed" class="sub-tab @(SubView == "completed" ? "active" : "")">COMPLETED</a>
                }
            </div>

            @if (SubView == "ongoing" || SubView == "completed")
            {
                @if (Session.Role == "PROFESSOR" && SubView == "ongoing")
                {
                    <div style="text-align:right; margin-bottom:20px;">
                        <button class="neon-btn btn-compact" @onclick="() => showAddMissionModal = true">+ CREATE MISSION</button>
                    </div>
                }

                @if (!missionsList.Any())
                {
                    <div class="admin-card" style="text-align:center; padding: 40px; color: #8B949E;">No missions recorded.</div>
                }
                else
                {
                    @foreach (var m in missionsList)
                    {
                        <div class="mission-row">
                            <div style="flex-grow:1;">
                                <h3 style="margin:0;">@m.Category: @m.TargetNumber</h3>
                                <p style="font-size:11px; color:@(SubView == "completed" ? "var(--neon-teal)" : "#4ade80"); font-weight:bold; margin-top:5px;">
                                    @(SubView == "completed" ? "ARCHIVED" : "DEPLOYED")
                                </p>
                                <p style="font-size:12px; color:#8B949E; margin-top:10px;">⏱ Limit: @m.TimeLimit s | Difficulty: @m.DifficultyLevel</p>
                            </div>

                            @if (Session.Role == "STUDENT")
                            {
                                <div class="stat-circle">Overall Rank<b>@(SubView == "completed" ? m.DisplayRank : "N/A")</b></div>
                                <div class="stat-circle" style="border-color:#4ade80;">Overall Score<b>@m.FinalScore/400</b></div>
                                <div class="stat-circle">Time<b>@m.DisplayTime</b></div>

                                @if (SubView == "ongoing")
                                {
                                    <a href="play?id=@m.Cid" class="control-btn neon-btn btn-compact" style="margin-left:20px;">START</a>
                                }
                                else
                                {
                                    <button class="control-btn neon-btn" style="width:auto; margin-left:20px; background: #30363d !important; color: #8B949E !important; cursor: default;" disabled>FINISHED</button>
                                }
                            }
                        </div>
                    }
                }
            }
            else if (SubView == "roster" && Session.Role == "PROFESSOR")
            {
                <div class="admin-card" style="padding: 0; overflow: hidden;">
                    <table class="admin-table">
                        <tr style="background: #1c2128;">
                            <th>Agent Name</th><th>Current Rank</th><th style="text-align:center;">Action</th>
                        </tr>
                        @if (sectionRoster.Any())
                        {
                            @foreach (var r in sectionRoster)
                            {
                                <tr>
                                    <td>@r.Name</td>
                                    <td><span class="badge role-student">@r.Rank</span></td>
                                    <td style="text-align:center;">
                                        <a href="progress?studid=@r.Uid&sid=@Sid" class="control-btn btn-green">VIEW LOGS</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" style="padding:40px; text-align:center; color:#8B949E;">No agents currently enrolled in this section.</td></tr>
                        }
                    </table>
                </div>
            }
        }
        else if (CurrentView == "extra" && Session.Role == "STUDENT")
        {
            <h2 style="margin-bottom:30px;">Badge Achievement Vault</h2>
            <div class="grid-container">
                @if (studentBadges.Any())
                {
                    @foreach (var b in studentBadges)
                    {
                        <div class="class-card" style="text-align: center; padding: 20px;">
                            <div class="card-banner" style="background: rgba(0, 229, 255, 0.1); border-radius: 10px; margin-bottom: 15px;">
                                <span style="font-size: 50px;">🏅</span>
                            </div>
                            <h3 style="margin: 10px 0 5px 0; color: var(--neon-teal);">@b.Name</h3>
                            <p style="font-size: 12px; color: #8B949E;">@b.Criteria</p>
                        </div>
                    }
                }
                else
                {
                    <div class="cyber-card" style="grid-column: 1 / -1; text-align: center; padding: 60px;">
                        <p style="color: #8B949E;">No achievements detected yet.</p>
                    </div>
                }
            </div>
        }
    }

</div>

<!-- MODAL: CREATE / JOIN CLASS -->
@if (showActionModal)
{
    <div class="modal">
        <div class="cyber-card" style="width:450px; padding:40px; position:relative;">
            <span style="position:absolute; right:20px; top:20px; cursor:pointer; color: white;" @onclick="() => showActionModal = false">✖</span>
            
            @if (Session.Role == "PROFESSOR")
            {
                <h2 style="margin-top:0;">Initialize Section</h2>
                <input type="text" class="input-field" placeholder="Section Name" @bind="newSectionName" />
                <input type="text" class="input-field" placeholder="Create Class Code" @bind="newSectionPass" />
                <div style="text-align:right;">
                    <button class="neon-btn" style="width:auto; padding:12px 40px; border-radius:10px;" @onclick="CreateSection">Create Class</button>
                </div>
            }
            else
            {
                <h1>Enter class code.</h1>
                <input type="text" class="input-field" placeholder="Class Code" style="background:transparent; border-bottom:2px solid #30363d; border-radius:0; color:white; font-size:18px;" @bind="joinCode" />
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <p style="color:#ff4444; font-size:12px; margin-top:10px;">@modalError</p>
                }
                <div style="text-align:right; margin-top:30px;">
                    <button class="neon-btn" style="width:auto; padding:12px 40px; border-radius:30px;" @onclick="JoinSection">Join class</button>
                </div>
            }
        </div>
    </div>
}

<!-- MODAL: CREATE MISSION (PROFESSOR) -->
@if (showAddMissionModal)
{
    <div class="modal">
        <div class="cyber-card" style="width:450px; padding:40px; position:relative;">
            <span style="position:absolute; right:20px; top:20px; cursor:pointer; color: white;" @onclick="() => showAddMissionModal = false">✖</span>
            <h2 style="color: var(--neon-teal); margin-top: 0; text-transform: uppercase;">New Mission Parameters</h2>

            <label style="color: #8B949E; font-size: 11px; font-weight: bold;">CATEGORY</label>
            <select class="input-field" @bind="newMissionCategory">
                <option value="Binary">Binary Numeration</option>
                <option value="Logic">Boolean Logic Gates</option>
            </select>

            <label style="color: #8B949E; font-size: 11px; font-weight: bold;">TARGET DECIMAL</label>
            <input type="number" class="input-field" @bind="newMissionTarget" />

            <label style="color: #8B949E; font-size: 11px; font-weight: bold;">TIME LIMIT (SECONDS)</label>
            <input type="number" class="input-field" @bind="newMissionTime" />

            <label style="color: #8B949E; font-size: 11px; font-weight: bold;">DIFFICULTY</label>
            <select class="input-field" @bind="newMissionDiff">
                <option value="Easy">Easy</option>
                <option value="Medium">Medium</option>
                <option value="Hard">Hard</option>
            </select>

            <button class="neon-btn" @onclick="CreateMission">DEPLOY TO ACADEMY</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? CurrentView { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? Filter { get; set; }
    [SupplyParameterFromQuery(Name = "sid")] public int? Sid { get; set; }
    [SupplyParameterFromQuery(Name = "sub")] public string? SubView { get; set; }

    private string searchTerm = "";
    private bool showActionModal = false;
    private bool showAddMissionModal = false;
    private string modalError = "";

    // Admin metrics
    private int totalUsers = 0;
    private int totalStudents = 0;
    private int globalSuccessRate = 0;

    // Form fields
    private string newSectionName = "";
    private string newSectionPass = "";
    private string joinCode = "";
    private string newMissionCategory = "Binary";
    private int newMissionTarget = 156;
    private int newMissionTime = 30;
    private string newMissionDiff = "Easy";

    // View models
    public class SectionDto
    {
        public int Sid { get; set; }
        public string SectionName { get; set; } = "";
        public string SectionPassword { get; set; } = "";
    }

    public class BadgeDto
    {
        public string Name { get; set; } = "";
        public string Criteria { get; set; } = "";
    }

    public class MissionDto
    {
        public int Cid { get; set; }
        public string Category { get; set; } = "";
        public int TargetNumber { get; set; }
        public int TimeLimit { get; set; }
        public string DifficultyLevel { get; set; } = "";
        public int FinalScore { get; set; }
        public string DisplayTime { get; set; } = "00:00";
        public string DisplayRank { get; set; } = "B";
    }

    public class RosterDto
    {
        public int Uid { get; set; }
        public string Name { get; set; } = "";
        public string Rank { get; set; } = "Novice";
    }

    private List<User> usersList = new();
    private List<User> archivedUsersList = new();
    private List<SectionDto> userSections = new();
    private List<MissionDto> missionsList = new();
    private List<BadgeDto> studentBadges = new();
    private List<RosterDto> sectionRoster = new();
    private SectionDto? currentSection;

    protected override void OnParametersSet()
    {
        CurrentView ??= "main";
        Filter ??= "ALL";
        SubView ??= "ongoing";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Session.Role == "ADMIN")
        {
            usersList = await Db.Users.Where(u => u.IsActive == 1).ToListAsync();
            archivedUsersList = await Db.Users.Where(u => u.IsActive == 0).ToListAsync();
            totalUsers = usersList.Count;
            totalStudents = usersList.Count(u => u.Role == "STUDENT");

            var totalRecords = await Db.ScoreRecords.CountAsync();
            var passedRecords = await Db.ScoreRecords.CountAsync(r => r.IsPassed == 1);
            globalSuccessRate = totalRecords > 0 ? (int)Math.Round(((double)passedRecords / totalRecords) * 100) : 0;
        }
        else
        {
            // Fetch Sections
            userSections.Clear();
            using (var cmd = Db.Database.GetDbConnection().CreateCommand())
            {
                await Db.Database.OpenConnectionAsync();
                if (Session.Role == "PROFESSOR")
                {
                    cmd.CommandText = $"SELECT s.sid, s.section_name, s.section_password FROM tblsection s JOIN tblsection_professor sp ON s.sid = sp.sid WHERE sp.pid = {Session.Uid}";
                }
                else
                {
                    cmd.CommandText = $"SELECT s.sid, s.section_name, s.section_password FROM tblsection s JOIN tblsection_student ss ON s.sid = ss.sid WHERE ss.studid = {Session.Uid}";
                }

                using (var reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        userSections.Add(new SectionDto
                        {
                            Sid = reader.GetInt32(0),
                            SectionName = reader.GetString(1),
                            SectionPassword = reader.GetString(2)
                        });
                    }
                }
            }

            // Drill down: Section Missions / Roster
            if (Sid.HasValue)
            {
                currentSection = userSections.FirstOrDefault(s => s.Sid == Sid.Value);

                if (SubView == "ongoing" || SubView == "completed")
                {
                    missionsList.Clear();
                    using (var cmd = Db.Database.GetDbConnection().CreateCommand())
                    {
                        await Db.Database.OpenConnectionAsync();
                        if (Session.Role == "PROFESSOR")
                        {
                            cmd.CommandText = $"SELECT c.cid, c.category, c.target_number, c.time_limit, c.difficulty_level FROM tblchallenge c JOIN tblchallenge_section cs ON c.cid = cs.cid WHERE cs.sid = {Sid.Value} ORDER BY c.cid DESC";
                        }
                        else if (SubView == "ongoing")
                        {
                            cmd.CommandText = $"SELECT c.cid, c.category, c.target_number, c.time_limit, c.difficulty_level FROM tblchallenge c JOIN tblchallenge_section cs ON c.cid = cs.cid WHERE cs.sid = {Sid.Value} AND c.cid NOT IN (SELECT cr.cid FROM tblchallenge_record cr JOIN tblstudent_record sr ON cr.srid = sr.srid WHERE sr.studid = {Session.Uid}) ORDER BY c.cid DESC";
                        }
                        else
                        {
                            cmd.CommandText = $"SELECT c.cid, c.category, c.target_number, c.time_limit, c.difficulty_level, r.final_score, r.time_taken FROM tblchallenge c JOIN tblchallenge_section cs ON c.cid = cs.cid JOIN tblchallenge_record cr ON c.cid = cr.cid JOIN tblstudent_record sr ON cr.srid = sr.srid JOIN tblscorerecord r ON sr.srid = r.srid WHERE cs.sid = {Sid.Value} AND sr.studid = {Session.Uid} ORDER BY r.date_completed DESC";
                        }

                        using (var reader = await cmd.ExecuteReaderAsync())
                        {
                            while (await reader.ReadAsync())
                            {
                                var m = new MissionDto
                                {
                                    Cid = reader.GetInt32(0),
                                    Category = reader.GetString(1),
                                    TargetNumber = reader.GetInt32(2),
                                    TimeLimit = reader.GetInt32(3),
                                    DifficultyLevel = reader.GetString(4)
                                };

                                if (SubView == "completed")
                                {
                                    m.FinalScore = reader.GetInt32(5);
                                    int seconds = reader.GetInt32(6);
                                    m.DisplayTime = $"{(seconds / 60):D2}:{(seconds % 60):D2}";
                                    m.DisplayRank = m.FinalScore >= 350 ? "S" : (m.FinalScore >= 200 ? "A" : "B");
                                }

                                missionsList.Add(m);
                            }
                        }
                    }
                }
                else if (SubView == "roster" && Session.Role == "PROFESSOR")
                {
                    sectionRoster.Clear();
                    using (var cmd = Db.Database.GetDbConnection().CreateCommand())
                    {
                        await Db.Database.OpenConnectionAsync();
                        cmd.CommandText = $"SELECT u.uid, u.name, s.rank FROM tbluser u JOIN tblstudent s ON u.uid = s.studid JOIN tblsection_student ss ON s.studid = ss.studid WHERE ss.sid = {Sid.Value} AND u.is_active = 1";
                        using (var reader = await cmd.ExecuteReaderAsync())
                        {
                            while (await reader.ReadAsync())
                            {
                                sectionRoster.Add(new RosterDto
                                {
                                    Uid = reader.GetInt32(0),
                                    Name = reader.GetString(1),
                                    Rank = reader.IsDBNull(2) ? "Novice" : reader.GetString(2)
                                });
                            }
                        }
                    }
                }
            }

            // Badges
            if (CurrentView == "extra" && Session.Role == "STUDENT")
            {
                studentBadges.Clear();
                using (var cmd = Db.Database.GetDbConnection().CreateCommand())
                {
                    await Db.Database.OpenConnectionAsync();
                    cmd.CommandText = $"SELECT b.badgename, b.criteriaMet FROM tblbadge b JOIN tblstudent_badge sb ON b.bid = sb.bid WHERE sb.studid = {Session.Uid}";
                    using (var reader = await cmd.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            studentBadges.Add(new BadgeDto
                            {
                                Name = reader.GetString(0),
                                Criteria = reader.GetString(1)
                            });
                        }
                    }
                }
            }
        }
    }

    private IEnumerable<User> FilteredUsers => usersList.Where(u =>
        (Filter == "ALL" || u.Role == Filter) &&
        (string.IsNullOrEmpty(searchTerm) || 
         u.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
         u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private async Task ToggleUserStatus(int uid, int activeStatus)
    {
        var target = await Db.Users.FindAsync(uid);
        if (target != null)
        {
            target.IsActive = activeStatus;
            await Db.SaveChangesAsync();
            await LoadData();
        }
    }

    private async Task CreateSection()
    {
        if (string.IsNullOrWhiteSpace(newSectionName) || string.IsNullOrWhiteSpace(newSectionPass)) return;

        using (var cmd = Db.Database.GetDbConnection().CreateCommand())
        {
            await Db.Database.OpenConnectionAsync();
            cmd.CommandText = $"INSERT INTO tblsection (section_name, semester, year, section_password) VALUES ('{newSectionName}', '1st', '2026', '{newSectionPass}'); SELECT LAST_INSERT_ID();";
            var newSid = Convert.ToInt32(await cmd.ExecuteScalarAsync());

            cmd.CommandText = $"INSERT INTO tblsection_professor (sid, pid) VALUES ({newSid}, {Session.Uid});";
            await cmd.ExecuteNonQueryAsync();
        }

        showActionModal = false;
        newSectionName = "";
        newSectionPass = "";
        await LoadData();
    }

    private async Task JoinSection()
    {
        modalError = "";
        if (string.IsNullOrWhiteSpace(joinCode)) return;

        using (var cmd = Db.Database.GetDbConnection().CreateCommand())
        {
            await Db.Database.OpenConnectionAsync();
            cmd.CommandText = $"SELECT sid FROM tblsection WHERE section_password = '{joinCode.Trim()}';";
            var result = await cmd.ExecuteScalarAsync();

            if (result != null)
            {
                int sid = Convert.ToInt32(result);
                cmd.CommandText = $"INSERT IGNORE INTO tblsection_student (sid, studid) VALUES ({sid}, {Session.Uid});";
                await cmd.ExecuteNonQueryAsync();

                showActionModal = false;
                joinCode = "";
                await LoadData();
            }
            else
            {
                modalError = "Invalid class code.";
            }
        }
    }

    private async Task CreateMission()
    {
        if (!Sid.HasValue) return;

        using (var cmd = Db.Database.GetDbConnection().CreateCommand())
        {
            await Db.Database.OpenConnectionAsync();
            cmd.CommandText = $"INSERT INTO tblchallenge (category, target_number, time_limit, difficulty_level) VALUES ('{newMissionCategory}', {newMissionTarget}, {newMissionTime}, '{newMissionDiff}'); SELECT LAST_INSERT_ID();";
            var newCid = Convert.ToInt32(await cmd.ExecuteScalarAsync());

            cmd.CommandText = $"INSERT INTO tblchallenge_section (cid, sid) VALUES ({newCid}, {Sid.Value});";
            await cmd.ExecuteNonQueryAsync();
        }

        showAddMissionModal = false;
        await LoadData();
    }

    private void TerminateSession()
    {
        Session.Clear();
        Nav.NavigateTo("/login");
    }
