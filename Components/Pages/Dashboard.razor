@page "/dashboard"
@using Microsoft.EntityFrameworkCore
@using BitFlipBlazor.Data
@using BitFlipBlazor.Models
@using BitFlipBlazor.Services
@inject AppDbContext Db
@inject UserSession Session
@inject NavigationManager Nav

<div class="px-8 py-8 max-w-[1300px] mx-auto min-h-screen text-white bg-[#0D1117]">
    
    <!-- HEADER -->
    <div class="flex justify-between items-center mb-6 border-b border-[#30363d]/60 pb-5">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
                SYSTEM: DASHBOARD
            </h1>
            <p class="text-[#8B949E] text-sm mt-1">
                Agent: <span class="text-white font-medium">@Session.Name</span> | 
                <span class="px-2 py-0.5 rounded text-[10px] font-bold tracking-wide uppercase 
                    @(Session.Role == "ADMIN" ? "bg-red-500/20 text-red-400 border border-red-500/40" : 
                      Session.Role == "PROFESSOR" ? "bg-blue-500/20 text-blue-400 border border-blue-500/40" : 
                      "bg-[#00E5FF]/20 text-[#00E5FF] border border-[#00E5FF]/40")">
                    @Session.Role
                </span>
            </p>
        </div>
        <div>
            <button class="px-4 py-2 text-xs font-bold tracking-wider text-[#00E5FF] bg-transparent border border-[#00E5FF] rounded-lg transition-all duration-200 hover:bg-[#00E5FF] hover:text-black hover:shadow-[0_0_12px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer" 
                    @onclick="TerminateSession">
                TERMINATE SESSION
            </button>
        </div>  
    </div>

    <!-- MAIN NAVIGATION TABS -->
    <div class="flex gap-8 border-b border-[#30363d] mb-8">
        @if (Session.Role == "ADMIN")
        {
            <button type="button" 
                    class="py-3 px-1 font-bold text-sm tracking-wide transition-all duration-200 border-b-2 cursor-pointer
                           @(CurrentView == "main" ? "text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-transparent hover:text-white")" 
                    @onclick='() => Nav.NavigateTo("dashboard?view=main")'>
                System Overview
            </button>
            <button type="button" 
                    class="py-3 px-1 font-bold text-sm tracking-wide transition-all duration-200 border-b-2 cursor-pointer
                           @(CurrentView == "users" ? "text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-transparent hover:text-white")" 
                    @onclick='() => Nav.NavigateTo("dashboard?view=users")'>
                User Directory
            </button>
            <button type="button" 
                    class="py-3 px-1 font-bold text-sm tracking-wide transition-all duration-200 border-b-2 cursor-pointer
                           @(CurrentView == "archive" ? "text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-transparent hover:text-white")" 
                    @onclick='() => Nav.NavigateTo("dashboard?view=archive")'>
                User Archive
            </button>
        }
        else
        {
            <button type="button" 
                    class="py-3 px-1 font-bold text-sm tracking-wide transition-all duration-200 border-b-2 cursor-pointer
                           @(CurrentView == "main" || CurrentView == "missions" ? "text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-transparent hover:text-white")"
                    @onclick='() => Nav.NavigateTo("dashboard?view=main")'>
                Classes
            </button>
            @if (Session.Role == "STUDENT")
            {
                <button type="button" 
                        class="py-3 px-1 font-bold text-sm tracking-wide transition-all duration-200 border-b-2 cursor-pointer
                               @(CurrentView == "extra" ? "text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-transparent hover:text-white")" 
                        @onclick='() => Nav.NavigateTo("dashboard?view=extra")'>
                    Badges
                </button>
            }
        }
    </div>

    <!-- ADMIN VIEWS -->
    @if (Session.Role == "ADMIN")
    {
        @if (CurrentView == "main")
        {
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h2 class="text-xl font-bold text-white tracking-tight">System Administration</h2>
                    <p class="text-red-400 text-xs font-mono font-bold tracking-wider mt-1">ROOT ACCESS: @Session.Name</p>
                </div>
                <div class="px-4 py-1.5 rounded-lg bg-red-950/40 border border-red-500 text-red-400 text-xs font-bold uppercase tracking-wider">
                    SYSTEM STATUS: STABLE
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-[#161B22] border border-[#30363d] border-t-4 border-t-red-500 rounded-xl p-6 shadow-lg">
                    <p class="text-[11px] text-[#8B949E] font-bold tracking-wider uppercase">TOTAL SYSTEM USERS</p>
                    <h2 class="text-4xl font-extrabold my-3 text-white">@totalUsers</h2>
                    <p class="text-xs text-[#8B949E]">Active Personnel</p>
                </div>
                <div class="bg-[#161B22] border border-[#30363d] border-t-4 border-t-[#00E5FF] rounded-xl p-6 shadow-lg">
                    <p class="text-[11px] text-[#8B949E] font-bold tracking-wider uppercase">ACTIVE STUDENTS</p>
                    <h2 class="text-4xl font-extrabold my-3 text-white">@totalStudents</h2>
                    <p class="text-xs text-[#00E5FF]">Live Players Only</p>
                </div>
                <div class="bg-[#161B22] border border-[#30363d] border-t-4 border-t-blue-500 rounded-xl p-6 shadow-lg">
                    <p class="text-[11px] text-[#8B949E] font-bold tracking-wider uppercase">GLOBAL SUCCESS RATE</p>
                    <h2 class="text-4xl font-extrabold my-3 text-white">@globalSuccessRate%</h2>
                    <p class="text-xs text-[#8B949E]">Pass Rate Percentage</p>
                </div>
            </div>
        }
        else if (CurrentView == "users")
        {
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                <p class="text-[#8B949E] text-xs font-bold tracking-widest uppercase">
                    AGENT DIRECTORY (Total: @FilteredUsers.Count())
                </p>
                <div class="flex gap-3 w-full sm:w-auto">
                    <button type="button" 
                            class="px-4 py-2 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-200 hover:bg-[#00f2ff] hover:shadow-[0_0_12px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer whitespace-nowrap" 
                            @onclick="() => showAdminCreateModal = true">
                        + CREATE AGENT
                    </button>
                    <input type="text" 
                           class="bg-[#161B22]/90 border border-[#30363d] rounded-full px-4 py-1.5 text-xs text-white outline-none w-64 transition-all duration-300 focus:w-72 focus:border-[#00E5FF] focus:shadow-[0_0_10px_rgba(0,229,255,0.2)] placeholder:text-gray-500" 
                           placeholder="SEARCH AGENTS..." 
                           @bind="searchTerm" 
                           @bind:event="oninput" />
                </div>
            </div>

            <!-- Sub Filter Nav -->
            <div class="flex gap-3 mb-6">
                @foreach (var f in new[] { "ALL", "STUDENT", "PROFESSOR", "ADMIN" })
                {
                    <button type="button" 
                            class="text-xs font-bold uppercase tracking-wider px-5 py-2 rounded-full border transition-all duration-200 cursor-pointer
                                   @(Filter == f 
                                       ? "bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF] shadow-[0_0_10px_rgba(0,229,255,0.2)]" 
                                       : "text-[#8B949E] border-[#30363d] hover:border-[#00E5FF] hover:text-white")"
                            @onclick='() => Nav.NavigateTo($"dashboard?view=users&filter={f}")'>
                        @f
                    </button>
                }
            </div>

            <div class="bg-[#161B22] border border-[#30363d] rounded-xl overflow-hidden shadow-lg">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-[#1c2128] text-[#8B949E] text-xs uppercase tracking-wider">
                        <tr>
                            <th class="p-4">UID</th>
                            <th class="p-4">Name</th>
                            <th class="p-4">Email</th>
                            <th class="p-4">Access</th>
                            <th class="p-4 text-center">Control</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#30363d] text-sm">
                        @if (FilteredUsers.Any())
                        {
                            @foreach (var u in FilteredUsers)
                            {
                                <tr class="hover:bg-[#1c2128]/50 transition-colors">
                                    <td class="p-4 text-[#8B949E] font-mono">#@u.Uid</td>
                                    <td class="p-4 font-semibold text-white">@u.Name</td>
                                    <td class="p-4 text-[#8B949E]">@u.Email</td>
                                    <td class="p-4">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase 
                                            @(u.Role == "ADMIN" ? "bg-red-500/20 text-red-400" : 
                                              u.Role == "PROFESSOR" ? "bg-blue-500/20 text-blue-400" : 
                                              "bg-[#00E5FF]/20 text-[#00E5FF]")">
                                            @u.Role
                                        </span>
                                    </td>
                                    <td class="p-4 text-center">
                                        <button class="px-3.5 py-1 text-xs font-bold rounded bg-red-950 text-red-400 border border-red-500 hover:bg-red-900 transition-all active:scale-95 cursor-pointer" 
                                                @onclick="() => ToggleUserStatus(u.Uid, 0)">
                                            ARCHIVE
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="p-10 text-center text-[#8B949E]">No agents found matching criteria.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (CurrentView == "archive")
        {
            <div class="mb-4">
                <p class="text-[#8B949E] text-xs font-bold tracking-widest uppercase">
                    TERMINATED AGENT LOGS (Total: @archivedUsersList.Count)
                </p>
            </div>

            <div class="bg-[#161B22] border border-[#30363d] border-t-4 border-t-amber-500 rounded-xl overflow-hidden shadow-lg">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-[#1c2128] text-[#8B949E] text-xs uppercase tracking-wider">
                        <tr>
                            <th class="p-4">UID</th>
                            <th class="p-4">Name</th>
                            <th class="p-4">Email</th>
                            <th class="p-4">Role</th>
                            <th class="p-4 text-center">Control</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#30363d] text-sm">
                        @if (archivedUsersList.Any())
                        {
                            @foreach (var u in archivedUsersList)
                            {
                                <tr class="hover:bg-[#1c2128]/50 transition-colors">
                                    <td class="p-4 text-[#8B949E] font-mono">#@u.Uid</td>
                                    <td class="p-4 font-semibold text-white">@u.Name</td>
                                    <td class="p-4 text-[#8B949E]">@u.Email</td>
                                    <td class="p-4">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-gray-800 text-gray-400">@u.Role</span>
                                    </td>
                                    <td class="p-4 text-center">
                                        <button class="px-3.5 py-1 text-xs font-bold rounded bg-emerald-950 text-emerald-400 border border-emerald-500 hover:bg-emerald-900 transition-all active:scale-95 cursor-pointer" 
                                                @onclick="() => ToggleUserStatus(u.Uid, 1)">
                                            RESTORE
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="p-10 text-center text-[#8B949E]">No archived accounts found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <!-- STUDENT & PROFESSOR VIEWS -->
    @if (Session.Role != "ADMIN")
    {
        @if (CurrentView == "main" || string.IsNullOrEmpty(CurrentView))
        {
            <h3 class="text-[#8B949E] font-bold text-sm tracking-wider uppercase mb-6">Active Classes</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                @foreach (var sec in userSections)
                {
                    <div class="bg-[#161B22] border border-[#30363d] rounded-xl overflow-hidden cursor-pointer transition-all duration-300 hover:-translate-y-1.5 hover:border-[#00E5FF] hover:shadow-[0_0_15px_rgba(0,229,255,0.2)] group" 
                         @onclick='() => Nav.NavigateTo($"dashboard?view=missions&sid={sec.Sid}")'>
                        <div class="h-28 flex items-center justify-center text-4xl group-hover:scale-110 transition-transform duration-300" 
                             style="background:@(sec.Sid % 2 == 0 ? "#fce4ec" : "#e0f7fa");">
                            👨‍💻
                        </div>
                        <div class="p-5">
                            <div class="font-bold text-base text-white truncate">@sec.SectionName</div>
                            <div class="text-xs text-[#8B949E] mt-1">Academic Year 2025–2026</div>
                            <div class="text-[11px] text-[#00E5FF] font-mono mt-3">ID: #@sec.Sid | Code: @sec.SectionPassword</div>
                        </div>
                    </div>
                }

                <div class="bg-[#161B22]/40 border-2 border-dashed border-[#30363d] rounded-xl flex flex-col items-center justify-center h-[216px] cursor-pointer transition-all duration-300 hover:border-[#00E5FF] hover:bg-[#161B22] group" 
                     @onclick="() => showActionModal = true">
                    <div class="text-3xl text-[#8B949E] group-hover:text-[#00E5FF] group-hover:scale-125 transition-all mb-2">+</div>
                    <b class="text-[#8B949E] text-xs font-bold uppercase tracking-wider group-hover:text-white transition-colors">
                        @(Session.Role == "PROFESSOR" ? "Create section" : "Join class")
                    </b>
                </div>
            </div>
        }
        else if (CurrentView == "missions" && Sid.HasValue)
        {
            <div class="flex items-center gap-4 mb-6">
                <button type="button" 
                        class="px-4 py-2 bg-red-950 text-red-400 border border-red-500 text-xs font-bold rounded-lg transition-all hover:bg-red-900 active:scale-95 cursor-pointer"
                        @onclick='() => Nav.NavigateTo("dashboard?view=main")'>
                    « BACK
                </button>
                <h2 class="text-xl font-bold text-white tracking-tight">@(currentSection?.SectionName ?? "Mission Hub")</h2>
            </div>

            <!-- Sub Nav -->
            <div class="flex gap-3 mb-6">
                @if (Session.Role == "PROFESSOR")
                {
                    <button type="button" 
                            class="text-xs font-bold uppercase tracking-wider px-5 py-2 rounded-full border transition-all duration-200 cursor-pointer
                                   @(SubView == "ongoing" ? "bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-[#30363d] hover:border-[#00E5FF] hover:text-white")"
                            @onclick='() => Nav.NavigateTo($"dashboard?view=missions&sid={Sid}&sub=ongoing")'>
                        CHALLENGES
                    </button>
                    <button type="button" 
                            class="text-xs font-bold uppercase tracking-wider px-5 py-2 rounded-full border transition-all duration-200 cursor-pointer
                                   @(SubView == "roster" ? "bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-[#30363d] hover:border-[#00E5FF] hover:text-white")"
                            @onclick='() => Nav.NavigateTo($"dashboard?view=missions&sid={Sid}&sub=roster")'>
                        STUDENT ROSTER
                    </button>
                }
                else
                {
                    <button type="button" 
                            class="text-xs font-bold uppercase tracking-wider px-5 py-2 rounded-full border transition-all duration-200 cursor-pointer
                                   @(SubView == "ongoing" ? "bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-[#30363d] hover:border-[#00E5FF] hover:text-white")"
                            @onclick='() => Nav.NavigateTo($"dashboard?view=missions&sid={Sid}&sub=ongoing")'>
                        ONGOING
                    </button>
                    <button type="button" 
                            class="text-xs font-bold uppercase tracking-wider px-5 py-2 rounded-full border transition-all duration-200 cursor-pointer
                                   @(SubView == "completed" ? "bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]" : "text-[#8B949E] border-[#30363d] hover:border-[#00E5FF] hover:text-white")"
                            @onclick='() => Nav.NavigateTo($"dashboard?view=missions&sid={Sid}&sub=completed")'>
                        COMPLETED
                    </button>
                }
            </div>

            @if (SubView == "ongoing" || SubView == "completed")
            {
                @if (Session.Role == "PROFESSOR" && SubView == "ongoing")
                {
                    <div class="text-right mb-4">
                        <button class="px-5 py-2.5 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer" 
                                @onclick="() => showAddMissionModal = true">
                            + CREATE MISSION
                        </button>
                    </div>
                }

                @if (!missionsList.Any())
                {
                    <div class="bg-[#161B22] border border-[#30363d] rounded-xl p-10 text-center text-[#8B949E]">
                        No missions recorded in this section.
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-4">
                        @foreach (var m in missionsList)
                        {
                            <div class="bg-[#161B22] border border-[#30363d] border-l-4 border-l-emerald-400 rounded-xl p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-md transition-all hover:border-[#00E5FF]/50">
                                <div class="flex-grow">
                                    <h3 class="text-base font-bold text-white tracking-tight">@m.Category: @m.TargetNumber</h3>
                                    <p class="text-[11px] font-bold mt-1 tracking-wider uppercase @(SubView == "completed" ? "text-[#00E5FF]" : "text-emerald-400")">
                                        @(SubView == "completed" ? "ARCHIVED" : "DEPLOYED")
                                    </p>
                                    <p class="text-xs text-[#8B949E] mt-2 font-mono">⏱ Limit: @m.TimeLimit s | Difficulty: @m.DifficultyLevel</p>
                                </div>

                                @if (Session.Role == "STUDENT")
                                {
                                    <div class="flex items-center gap-3">
                                        <div class="w-16 h-16 rounded-full border-2 border-[#30363d] flex flex-col items-center justify-center text-center text-[9px] text-[#8B949E]">
                                            RANK<b class="text-xs text-white">@(SubView == "completed" ? m.DisplayRank : "N/A")</b>
                                        </div>
                                        <div class="w-16 h-16 rounded-full border-2 border-emerald-400 flex flex-col items-center justify-center text-center text-[9px] text-[#8B949E]">
                                            SCORE<b class="text-xs text-white">@m.FinalScore/400</b>
                                        </div>
                                        <div class="w-16 h-16 rounded-full border-2 border-[#30363d] flex flex-col items-center justify-center text-center text-[9px] text-[#8B949E]">
                                            TIME<b class="text-xs text-white font-mono">@m.DisplayTime</b>
                                        </div>

                                        @if (SubView == "ongoing")
                                        {
                                            <button type="button" 
                                                    class="ml-3 px-5 py-2.5 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer"
                                                    @onclick='() => Nav.NavigateTo($"play?id={m.Cid}")'>
                                                START
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="ml-3 px-5 py-2.5 bg-gray-800 text-gray-500 font-bold uppercase tracking-wider text-xs rounded-lg cursor-not-allowed" disabled>
                                                FINISHED
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else if (SubView == "roster" && Session.Role == "PROFESSOR")
            {
                <div class="bg-[#161B22] border border-[#30363d] rounded-xl overflow-hidden shadow-lg">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-[#1c2128] text-[#8B949E] text-xs uppercase tracking-wider">
                            <tr>
                                <th class="p-4">Agent Name</th>
                                <th class="p-4">Current Rank</th>
                                <th class="p-4 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#30363d] text-sm">
                            @if (sectionRoster.Any())
                            {
                                @foreach (var r in sectionRoster)
                                {
                                    <tr class="hover:bg-[#1c2128]/50 transition-colors">
                                        <td class="p-4 font-semibold text-white">@r.Name</td>
                                        <td class="p-4">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-[#00E5FF]/20 text-[#00E5FF] border border-[#00E5FF]/30">@r.Rank</span>
                                        </td>
                                        <td class="p-4 text-center">
                                            <button type="button" 
                                                    class="px-3.5 py-1 text-xs font-bold rounded bg-emerald-950 text-emerald-400 border border-emerald-500 hover:bg-emerald-900 transition-all active:scale-95 cursor-pointer"
                                                    @onclick='() => Nav.NavigateTo($"progress?studid={r.Uid}&sid={Sid}")'>
                                                VIEW LOGS
                                            </button>                                    
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="p-10 text-center text-[#8B949E]">No agents currently enrolled in this section.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (CurrentView == "extra" && Session.Role == "STUDENT")
        {
            <h2 class="text-xl font-bold text-white tracking-tight mb-6">Badge Achievement Vault</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                @if (studentBadges.Any())
                {
                    @foreach (var b in studentBadges)
                    {
                        <div class="bg-[#161B22] border border-[#30363d] rounded-xl p-5 text-center transition-all hover:border-[#00E5FF] hover:-translate-y-1">
                            <div class="h-24 bg-[#00E5FF]/10 rounded-lg flex items-center justify-center text-4xl mb-4">
                                🏅
                            </div>
                            <h3 class="font-bold text-base text-[#00E5FF] mb-1">@b.Name</h3>
                            <p class="text-xs text-[#8B949E]">@b.Criteria</p>
                        </div>
                    }
                }
                else
                {
                    <div class="col-span-full bg-[#161B22] border border-[#30363d] rounded-xl p-12 text-center text-[#8B949E]">
                        No achievements detected yet.
                    </div>
                }
            </div>
        }
    }

</div>

<!-- MODAL: ADMIN CREATE USER -->
@if (showAdminCreateModal)
{
    <div class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-[#161B22] border border-[#30363d] rounded-xl w-full max-w-md p-8 relative shadow-2xl">
            <button class="absolute top-5 right-5 text-gray-400 hover:text-white cursor-pointer text-lg" @onclick="() => showAdminCreateModal = false">✖</button>
            <h2 class="text-[#00E5FF] text-base font-bold uppercase tracking-wider mb-5">PROVISION NEW AGENT</h2>

            <div class="flex flex-col gap-3">
                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">NAME</label>
                    <input type="text" class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" placeholder="Full Name" @bind="adminNewName" />
                </div>

                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">EMAIL</label>
                    <input type="email" class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" placeholder="Email Address" @bind="adminNewEmail" />
                </div>

                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">CLEARANCE LEVEL (ROLE)</label>
                    <select class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" @bind="adminNewRole">
                        <option value="STUDENT">STUDENT</option>
                        <option value="PROFESSOR">PROFESSOR</option>
                        <option value="ADMIN">ADMIN</option>
                    </select>
                </div>

                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">PASSWORD</label>
                    <input type="password" class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" placeholder="Initial Security Key" @bind="adminNewPass" />
                </div>

                @if (!string.IsNullOrEmpty(adminModalError))
                {
                    <p class="text-red-400 text-xs mt-1">@adminModalError</p>
                }

                <button class="w-full mt-3 py-3 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer" @onclick="AdminCreateUser">
                    INITIALIZE IN DATABASE
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL: CREATE / JOIN CLASS -->
@if (showActionModal)
{
    <div class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-[#161B22] border border-[#30363d] rounded-xl w-full max-w-md p-8 relative shadow-2xl">
            <button class="absolute top-5 right-5 text-gray-400 hover:text-white cursor-pointer text-lg" @onclick="() => showActionModal = false">✖</button>
            
            @if (Session.Role == "PROFESSOR")
            {
                <h2 class="text-lg font-bold text-white mb-4">Initialize Section</h2>
                <div class="flex flex-col gap-3">
                    <input type="text" class="w-full bg-[#f0ece2] text-black px-3.5 py-2.5 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" placeholder="Section Name" @bind="newSectionName" />
                    <input type="text" class="w-full bg-[#f0ece2] text-black px-3.5 py-2.5 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" placeholder="Create Class Code" @bind="newSectionPass" />
                    <div class="text-right mt-2">
                        <button class="px-6 py-2.5 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer" @onclick="CreateSection">
                            Create Class
                        </button>
                    </div>
                </div>
            }
            else
            {
                <h2 class="text-lg font-bold text-white mb-4">Enter class code.</h2>
                <div class="flex flex-col gap-3">
                    <input type="text" class="w-full bg-transparent border-b-2 border-[#30363d] px-2 py-3 text-white text-lg outline-none focus:border-[#00E5FF] transition-colors" placeholder="Class Code" @bind="joinCode" />
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <p class="text-red-400 text-xs">@modalError</p>
                    }
                    <div class="text-right mt-4">
                        <button class="px-8 py-2.5 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-full transition-all duration-300 hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer" @onclick="JoinSection">
                            Join class
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- MODAL: CREATE MISSION (PROFESSOR) -->
@if (showAddMissionModal)
{
    <div class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-[#161B22] border border-[#30363d] rounded-xl w-full max-w-md p-8 relative shadow-2xl">
            <button class="absolute top-5 right-5 text-gray-400 hover:text-white cursor-pointer text-lg" @onclick="() => showAddMissionModal = false">✖</button>
            <h2 class="text-[#00E5FF] text-base font-bold uppercase tracking-wider mb-5">New Mission Parameters</h2>

            <div class="flex flex-col gap-3">
                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">CATEGORY</label>
                    <select class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" @bind="newMissionCategory">
                        <option value="Binary">Binary Numeration</option>
                        <option value="Logic">Boolean Logic Gates</option>
                    </select>
                </div>

                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">TARGET DECIMAL</label>
                    <input type="number" class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" @bind="newMissionTarget" />
                </div>

                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">TIME LIMIT (SECONDS)</label>
                    <input type="number" class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" @bind="newMissionTime" />
                </div>

                <div>
                    <label class="text-[#8B949E] text-[11px] font-bold block mb-1">DIFFICULTY</label>
                    <select class="w-full bg-[#f0ece2] text-black px-3.5 py-2 rounded text-sm outline-none focus:ring-2 focus:ring-[#00E5FF]" @bind="newMissionDiff">
                        <option value="Easy">Easy</option>
                        <option value="Medium">Medium</option>
                        <option value="Hard">Hard</option>
                    </select>
                </div>

                <button class="w-full mt-3 py-3 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer" @onclick="CreateMission">
                    DEPLOY TO ACADEMY
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? CurrentView { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? Filter { get; set; }
    [SupplyParameterFromQuery(Name = "sid")] public int? Sid { get; set; }
    [SupplyParameterFromQuery(Name = "sub")] public string? SubView { get; set; }

    private string searchTerm = "";
    private bool showActionModal = false;
    private bool showAddMissionModal = false;
    private string modalError = "";

    // Admin metrics
    private int totalUsers = 0;
    private int totalStudents = 0;
    private int globalSuccessRate = 0;

    // Form fields
    private string newSectionName = "";
    private string newSectionPass = "";
    private string joinCode = "";
    private string newMissionCategory = "Binary";
    private int newMissionTarget = 156;
    private int newMissionTime = 30;
    private string newMissionDiff = "Easy";

    private bool showAdminCreateModal = false;
    private string adminNewName = "";
    private string adminNewEmail = "";
    private string adminNewRole = "STUDENT";
    private string adminNewPass = "";
    private string adminModalError = "";

    public class SectionDto
    {
        public int Sid { get; set; }
        public string SectionName { get; set; } = "";
        public string SectionPassword { get; set; } = "";
    }

    public class BadgeDto
    {
        public string Name { get; set; } = "";
        public string Criteria { get; set; } = "";
    }

    public class MissionDto
    {
        public int Cid { get; set; }
        public string Category { get; set; } = "";
        public int TargetNumber { get; set; }
        public int TimeLimit { get; set; }
        public string DifficultyLevel { get; set; } = "";
        public int FinalScore { get; set; }
        public string DisplayTime { get; set; } = "00:00";
        public string DisplayRank { get; set; } = "B";
    }

    public class RosterDto
    {
        public int Uid { get; set; }
        public string Name { get; set; } = "";
        public string Rank { get; set; } = "Novice";
    }

    private List<User> usersList = new();
    private List<User> archivedUsersList = new();
    private List<SectionDto> userSections = new();
    private List<MissionDto> missionsList = new();
    private List<BadgeDto> studentBadges = new();
    private List<RosterDto> sectionRoster = new();
    private SectionDto? currentSection;

    protected override void OnParametersSet()
    {
        CurrentView ??= "main";
        Filter ??= "ALL";
        SubView ??= "ongoing";
    }

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Session.IsAuthenticated)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        if (Session.Role == "ADMIN")
        {
            usersList = await Db.Users.Where(u => u.IsActive == 1).ToListAsync();
            archivedUsersList = await Db.Users.Where(u => u.IsActive == 0).ToListAsync();
            totalUsers = usersList.Count;
            totalStudents = usersList.Count(u => u.Role == "STUDENT");

            var totalRecords = await Db.ScoreRecords.CountAsync();
            var passedRecords = await Db.ScoreRecords.CountAsync(r => r.IsPassed == 1);
            globalSuccessRate = totalRecords > 0 ? (int)Math.Round(((double)passedRecords / totalRecords) * 100) : 0;
        }
        else
        {
            userSections.Clear();
            using (var cmd = Db.Database.GetDbConnection().CreateCommand())
            {
                await Db.Database.OpenConnectionAsync();
                if (Session.Role == "PROFESSOR")
                {
                    cmd.CommandText = $"SELECT s.sid, s.section_name, s.section_password FROM tblsection s JOIN tblsection_professor sp ON s.sid = sp.sid WHERE sp.pid = {Session.Uid}";
                }
                else
                {
                    cmd.CommandText = $"SELECT s.sid, s.section_name, s.section_password FROM tblsection s JOIN tblsection_student ss ON s.sid = ss.sid WHERE ss.studid = {Session.Uid}";
                }

                using (var reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        userSections.Add(new SectionDto
                        {
                            Sid = reader.GetInt32(0),
                            SectionName = reader.GetString(1),
                            SectionPassword = reader.GetString(2)
                        });
                    }
                }
            }

            if (Sid.HasValue)
            {
                currentSection = userSections.FirstOrDefault(s => s.Sid == Sid.Value);

                if (SubView == "ongoing" || SubView == "completed")
                {
                    missionsList.Clear();
                    using (var cmd = Db.Database.GetDbConnection().CreateCommand())
                    {
                        await Db.Database.OpenConnectionAsync();
                        if (Session.Role == "PROFESSOR")
                        {
                            cmd.CommandText = $"SELECT c.cid, c.category, c.target_number, c.time_limit, c.difficulty_level FROM tblchallenge c JOIN tblchallenge_section cs ON c.cid = cs.cid WHERE cs.sid = {Sid.Value} ORDER BY c.cid DESC";
                        }
                        else if (SubView == "ongoing")
                        {
                            cmd.CommandText = $"SELECT c.cid, c.category, c.target_number, c.time_limit, c.difficulty_level FROM tblchallenge c JOIN tblchallenge_section cs ON c.cid = cs.cid WHERE cs.sid = {Sid.Value} AND c.cid NOT IN (SELECT cr.cid FROM tblchallenge_record cr JOIN tblstudent_record sr ON cr.srid = sr.srid WHERE sr.studid = {Session.Uid}) ORDER BY c.cid DESC";
                        }
                        else
                        {
                            cmd.CommandText = $"SELECT c.cid, c.category, c.target_number, c.time_limit, c.difficulty_level, r.final_score, r.time_taken FROM tblchallenge c JOIN tblchallenge_section cs ON c.cid = cs.cid JOIN tblchallenge_record cr ON c.cid = cr.cid JOIN tblstudent_record sr ON cr.srid = sr.srid JOIN tblscorerecord r ON sr.srid = r.srid WHERE cs.sid = {Sid.Value} AND sr.studid = {Session.Uid} ORDER BY r.date_completed DESC";
                        }

                        using (var reader = await cmd.ExecuteReaderAsync())
                        {
                            while (await reader.ReadAsync())
                            {
                                var m = new MissionDto
                                {
                                    Cid = reader.GetInt32(0),
                                    Category = reader.GetString(1),
                                    TargetNumber = reader.GetInt32(2),
                                    TimeLimit = reader.GetInt32(3),
                                    DifficultyLevel = reader.GetString(4)
                                };

                                if (SubView == "completed")
                                {
                                    m.FinalScore = reader.GetInt32(5);
                                    int seconds = reader.GetInt32(6);
                                    m.DisplayTime = $"{(seconds / 60):D2}:{(seconds % 60):D2}";
                                    m.DisplayRank = m.FinalScore >= 350 ? "S" : (m.FinalScore >= 200 ? "A" : "B");
                                }

                                missionsList.Add(m);
                            }
                        }
                    }
                }
                else if (SubView == "roster" && Session.Role == "PROFESSOR")
                {
                    sectionRoster.Clear();
                    using (var cmd = Db.Database.GetDbConnection().CreateCommand())
                    {
                        await Db.Database.OpenConnectionAsync();
                        cmd.CommandText = $"SELECT u.uid, u.name, s.rank FROM tbluser u JOIN tblstudent s ON u.uid = s.studid JOIN tblsection_student ss ON s.studid = ss.studid WHERE ss.sid = {Sid.Value} AND u.is_active = 1";
                        using (var reader = await cmd.ExecuteReaderAsync())
                        {
                            while (await reader.ReadAsync())
                            {
                                sectionRoster.Add(new RosterDto
                                {
                                    Uid = reader.GetInt32(0),
                                    Name = reader.GetString(1),
                                    Rank = reader.IsDBNull(2) ? "Novice" : reader.GetString(2)
                                });
                            }
                        }
                    }
                }
            }

            if (CurrentView == "extra" && Session.Role == "STUDENT")
            {
                studentBadges.Clear();
                using (var cmd = Db.Database.GetDbConnection().CreateCommand())
                {
                    await Db.Database.OpenConnectionAsync();
                    cmd.CommandText = $"SELECT b.badgename, b.criteriaMet FROM tblbadge b JOIN tblstudent_badge sb ON b.bid = sb.bid WHERE sb.studid = {Session.Uid}";
                    using (var reader = await cmd.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            studentBadges.Add(new BadgeDto
                            {
                                Name = reader.GetString(0),
                                Criteria = reader.GetString(1)
                            });
                        }
                    }
                }
            }
        }
    }

    private IEnumerable<User> FilteredUsers => usersList.Where(u =>
        (Filter == "ALL" || u.Role == Filter) &&
        (string.IsNullOrEmpty(searchTerm) || 
         u.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
         u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private async Task ToggleUserStatus(int uid, int activeStatus)
    {
        var target = await Db.Users.FindAsync(uid);
        if (target != null)
        {
            target.IsActive = activeStatus;
            await Db.SaveChangesAsync();
            await LoadData();
        }
    }

    private async Task AdminCreateUser()
    {
        adminModalError = "";
        if (string.IsNullOrWhiteSpace(adminNewName) || string.IsNullOrWhiteSpace(adminNewEmail) || string.IsNullOrWhiteSpace(adminNewPass))
        {
            adminModalError = "All parameters are mandatory.";
            return;
        }

        var exists = await Db.Users.AnyAsync(u => u.Email.ToLower() == adminNewEmail.Trim().ToLower());
        if (exists)
        {
            adminModalError = "An agent with this email already exists.";
            return;
        }

        var newUser = new User
        {
            Name = adminNewName.Trim(),
            Email = adminNewEmail.Trim().ToLower(),
            Password = adminNewPass,
            Role = adminNewRole,
            IsActive = 1
        };

        Db.Users.Add(newUser);
        await Db.SaveChangesAsync();

        if (adminNewRole == "STUDENT")
        {
            var newStudent = new Student
            {
                StudId = newUser.Uid,
                Rank = "Novice"
            };
            Db.Students.Add(newStudent);
            await Db.SaveChangesAsync();
        }

        showAdminCreateModal = false;
        adminNewName = "";
        adminNewEmail = "";
        adminNewPass = "";
        await LoadData();
    }

    private async Task CreateSection()
    {
        if (string.IsNullOrWhiteSpace(newSectionName) || string.IsNullOrWhiteSpace(newSectionPass)) return;

        using (var cmd = Db.Database.GetDbConnection().CreateCommand())
        {
            await Db.Database.OpenConnectionAsync();
            cmd.CommandText = $"INSERT INTO tblsection (section_name, semester, year, section_password) VALUES (@name, '1st', '2026', @pass) RETURNING sid;";
            
            var pName = cmd.CreateParameter(); pName.ParameterName = "@name"; pName.Value = newSectionName; cmd.Parameters.Add(pName);
            var pPass = cmd.CreateParameter(); pPass.ParameterName = "@pass"; pPass.Value = newSectionPass; cmd.Parameters.Add(pPass);

            var newSid = Convert.ToInt32(await cmd.ExecuteScalarAsync());

            cmd.Parameters.Clear();
            cmd.CommandText = $"INSERT INTO tblsection_professor (sid, pid) VALUES (@sid, @pid);";
            var pSid = cmd.CreateParameter(); pSid.ParameterName = "@sid"; pSid.Value = newSid; cmd.Parameters.Add(pSid);
            var pPid = cmd.CreateParameter(); pPid.ParameterName = "@pid"; pPid.Value = Session.Uid; cmd.Parameters.Add(pPid);
            
            await cmd.ExecuteNonQueryAsync();
        }

        showActionModal = false;
        newSectionName = "";
        newSectionPass = "";
        await LoadData();
    }

    private async Task JoinSection()
    {
        modalError = "";
        if (string.IsNullOrWhiteSpace(joinCode)) return;

        using (var cmd = Db.Database.GetDbConnection().CreateCommand())
        {
            await Db.Database.OpenConnectionAsync();
            cmd.CommandText = $"SELECT sid FROM tblsection WHERE section_password = @code;";
            var pCode = cmd.CreateParameter();
            pCode.ParameterName = "@code";
            pCode.Value = joinCode.Trim();
            cmd.Parameters.Add(pCode);
            var result = await cmd.ExecuteScalarAsync();

            if (result != null)
            {
                int sid = Convert.ToInt32(result);
                cmd.CommandText = $"INSERT INTO tblsection_student (sid, studid) VALUES ({sid}, {Session.Uid}) ON CONFLICT DO NOTHING;";
                await cmd.ExecuteNonQueryAsync();

                showActionModal = false;
                joinCode = "";
                await LoadData();
            }
            else
            {
                modalError = "Invalid class code.";
            }
        }
    }

    private async Task CreateMission()
    {
        if (!Sid.HasValue) return;

        using (var cmd = Db.Database.GetDbConnection().CreateCommand())
        {
            await Db.Database.OpenConnectionAsync();
            cmd.CommandText = $"INSERT INTO tblchallenge (category, target_number, time_limit, difficulty_level) VALUES ('{newMissionCategory}', {newMissionTarget}, {newMissionTime}, '{newMissionDiff}') RETURNING cid;";
            var newCid = Convert.ToInt32(await cmd.ExecuteScalarAsync());

            cmd.CommandText = $"INSERT INTO tblchallenge_section (cid, sid) VALUES ({newCid}, {Sid.Value});";
            await cmd.ExecuteNonQueryAsync();
        }

        showAddMissionModal = false;
        await LoadData();
    }

    private void TerminateSession()
    {
        Session.Clear();
        Nav.NavigateTo("/login");
    }
}
