@page "/progress"
@using BitFlipBlazor.Data
@using BitFlipBlazor.Models
@using BitFlipBlazor.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Cadet Progress Dossier | Bit-Flip Academy</PageTitle>

<div class="px-8 py-8 max-w-[1200px] mx-auto min-h-screen text-white bg-[#0D1117]">
    <div class="flex justify-between items-center mb-8 border-b border-[#30363d] pb-5">
        <div>
            <h1 class="text-2xl font-bold tracking-tight uppercase">DOSSIER: @studentName</h1>
            <p class="text-[#8B949E] text-xs font-mono mt-1">
                RANK: <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-[#00E5FF]/20 text-[#00E5FF] border border-[#00E5FF]/30">@studentRank</span> | SECTION ID: #@SectionId
            </p>
        </div>
        <div>
            <button type="button" 
                    class="px-5 py-2.5 bg-red-950 text-red-400 border border-red-500 text-xs font-bold rounded-lg transition-all hover:bg-red-900 active:scale-95 cursor-pointer" 
                    @onclick="ReturnToDashboard">
                « RETURN TO HUD
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-[#161B22] border border-[#30363d] rounded-xl text-center p-12 text-[#8B949E] font-mono animate-pulse">
            RETRIEVING AGENT LOGS...
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-[#161B22] border border-[#30363d] border-t-4 border-t-[#00E5FF] rounded-xl p-6 shadow-lg">
                <p class="text-[11px] text-[#8B949E] font-bold tracking-wider uppercase">TOTAL MISSIONS ATTEMPTED</p>
                <h2 class="text-3xl font-extrabold my-2 text-white">@historyLogs.Count</h2>
            </div>
            <div class="bg-[#161B22] border border-[#30363d] border-t-4 border-t-blue-500 rounded-xl p-6 shadow-lg">
                <p class="text-[11px] text-[#8B949E] font-bold tracking-wider uppercase">SUCCESSFUL DEPLOYMENTS</p>
                <h2 class="text-3xl font-extrabold my-2 text-emerald-400">@historyLogs.Count(l => l.IsPassed == 1)</h2>
            </div>
            <div class="bg-[#161B22] border border-[#30363d] border-t-4 border-t-red-500 rounded-xl p-6 shadow-lg">
                <p class="text-[11px] text-[#8B949E] font-bold tracking-wider uppercase">AVERAGE SCORE</p>
                <h2 class="text-3xl font-extrabold my-2 text-[#00E5FF]">
                    @(historyLogs.Any() ? (int)historyLogs.Average(l => l.FinalScore) : 0) / 400
                </h2>
            </div>
        </div>

        <div class="bg-[#161B22] border border-[#30363d] rounded-xl overflow-hidden shadow-lg">
            <table class="w-full text-left border-collapse">
                <thead class="bg-[#1c2128] text-[#8B949E] text-xs uppercase tracking-wider">
                    <tr>
                        <th class="p-4">Mission ID</th>
                        <th class="p-4">Category</th>
                        <th class="p-4">Target</th>
                        <th class="p-4">Score</th>
                        <th class="p-4">Time</th>
                        <th class="p-4">Timestamp</th>
                        <th class="p-4">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#30363d] text-sm">
                    @if (historyLogs.Any())
                    {
                        @foreach (var log in historyLogs)
                        {
                            <tr class="hover:bg-[#1c2128]/50 transition-colors">
                                <td class="p-4 text-[#8B949E] font-mono">#@log.Cid</td>
                                <td class="p-4 font-semibold text-white">@log.Category</td>
                                <td class="p-4 font-mono text-[#00E5FF]">@log.TargetNumber</td>
                                <td class="p-4 font-bold text-white">@log.FinalScore / 400</td>
                                <td class="p-4 text-gray-300 font-mono">@log.TimeTaken s</td>
                                <td class="p-4 text-[#8B949E] text-xs font-mono">@log.DateCompleted.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="p-4">
                                    @if (log.IsPassed == 1)
                                    {
                                        <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-950 text-emerald-400 border border-emerald-500">PASSED</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase bg-red-950 text-red-400 border border-red-500">FAILED</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-10 text-center text-[#8B949E]">
                                No simulation data logged for this cadet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "studid")]
    public int? StudentId { get; set; }

    [SupplyParameterFromQuery(Name = "sid")]
    public int? SectionId { get; set; }

    private string studentName = "Cadet";
    private string studentRank = "Novice";
    private bool isLoading = true;

    private class ProgressLogDto
    {
        public int Cid { get; set; }
        public string Category { get; set; } = "";
        public int TargetNumber { get; set; }
        public int FinalScore { get; set; }
        public int TimeTaken { get; set; }
        public DateTime DateCompleted { get; set; }
        public int IsPassed { get; set; }
    }

    private List<ProgressLogDto> historyLogs = new();

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!StudentId.HasValue)
        {
            isLoading = false;
            return;
        }

        var user = await Db.Users.FirstOrDefaultAsync(u => u.Uid == StudentId.Value);
        var student = await Db.Students.FirstOrDefaultAsync(s => s.StudId == StudentId.Value);
        
        if (user != null) studentName = user.Name;
        if (student != null) studentRank = student.Rank;

        historyLogs.Clear();
        using (var cmd = Db.Database.GetDbConnection().CreateCommand())
        {
            await Db.Database.OpenConnectionAsync();
            cmd.CommandText = @"
                SELECT c.cid, c.category, c.target_number, r.final_score, r.time_taken, r.date_completed, r.is_passed
                FROM tblscorerecord r
                JOIN tblstudent_record sr ON r.srid = sr.srid
                JOIN tblchallenge_record cr ON r.srid = cr.srid
                JOIN tblchallenge c ON cr.cid = c.cid
                WHERE sr.studid = @studid
                ORDER BY r.date_completed DESC;";

            var pStud = cmd.CreateParameter();
            pStud.ParameterName = "@studid";
            pStud.Value = StudentId.Value;
            cmd.Parameters.Add(pStud);

            using (var reader = await cmd.ExecuteReaderAsync())
            {
                while (await reader.ReadAsync())
                {
                    historyLogs.Add(new ProgressLogDto
                    {
                        Cid = reader.GetInt32(0),
                        Category = reader.GetString(1),
                        TargetNumber = reader.GetInt32(2),
                        FinalScore = reader.GetInt32(3),
                        TimeTaken = reader.GetInt32(4),
                        DateCompleted = reader.GetDateTime(5),
                        IsPassed = reader.GetInt32(6)
                    });
                }
            }
        }

        isLoading = false;
    }

    private void ReturnToDashboard()
    {
        if (SectionId.HasValue)
        {
            Nav.NavigateTo($"dashboard?view=missions&sid={SectionId.Value}&sub=roster");
        }
        else
        {
            Nav.NavigateTo("dashboard?view=main");
        }
    }
}
