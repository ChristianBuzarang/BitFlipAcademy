@page "/register"
@using Microsoft.EntityFrameworkCore
@using BitFlipBlazor.Data
@using BitFlipBlazor.Models
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Agent Enrollment</PageTitle>

<div class="min-h-screen flex flex-col justify-center items-center pb-20 bg-[#0D1117] text-white select-none">
    <img src="bitflip_logo.png" class="max-w-[130px] mb-4 drop-shadow-[0_0_10px_rgba(0,229,255,0.3)]" alt="Bit-Flip Logo" />
    <p class="text-[#00E5FF] tracking-[2px] font-bold mb-5 text-sm uppercase">ENROLL AGENT</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="w-[320px] mb-4 p-2.5 rounded bg-red-950/60 border border-red-500/50 text-red-400 text-xs text-center">
            @errorMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="w-[320px] mb-4 p-2.5 rounded bg-emerald-950/60 border border-emerald-500/50 text-emerald-400 text-xs text-center">
            @successMessage
        </div>
    }

    <div class="w-[320px] flex flex-col gap-3">
        <div>
            <label class="text-[#8B949E] text-[11px] font-bold uppercase tracking-wider block mb-1">Full Name</label>
            <input type="text" class="w-full bg-[#f0ece2] text-black px-3.5 py-2.5 rounded-md outline-none text-sm transition-all focus:ring-2 focus:ring-[#00E5FF] focus:bg-white placeholder:text-gray-500" placeholder="Operative Name" @bind="name" required />
        </div>

        <div>
            <label class="text-[#8B949E] text-[11px] font-bold uppercase tracking-wider block mb-1">Email Address</label>
            <input type="email" class="w-full bg-[#f0ece2] text-black px-3.5 py-2.5 rounded-md outline-none text-sm transition-all focus:ring-2 focus:ring-[#00E5FF] focus:bg-white placeholder:text-gray-500" placeholder="School Email" @bind="email" required />
        </div>

        <div>
            <label class="text-[#8B949E] text-[11px] font-bold uppercase tracking-wider block mb-1">Academy Role</label>
            <select class="w-full bg-[#f0ece2] text-black px-3.5 py-2.5 rounded-md outline-none text-sm transition-all focus:ring-2 focus:ring-[#00E5FF] focus:bg-white cursor-pointer" @bind="role">
                <option value="STUDENT">Cadet (Student)</option>
                <option value="PROFESSOR">Instructor (Professor)</option>
            </select>
        </div>

        <div>
            <label class="text-[#8B949E] text-[11px] font-bold uppercase tracking-wider block mb-1">Security Key (Password)</label>
            <input type="password" class="w-full bg-[#f0ece2] text-black px-3.5 py-2.5 rounded-md outline-none text-sm transition-all focus:ring-2 focus:ring-[#00E5FF] focus:bg-white placeholder:text-gray-500" placeholder="Password" @bind="password" required />
        </div>

        <div>
            <label class="text-[#8B949E] text-[11px] font-bold uppercase tracking-wider block mb-1">Confirm Security Key</label>
            <input type="password" class="w-full bg-[#f0ece2] text-black px-3.5 py-2.5 rounded-md outline-none text-sm transition-all focus:ring-2 focus:ring-[#00E5FF] focus:bg-white placeholder:text-gray-500" placeholder="Re-enter Password" @bind="confirmPassword" required />
        </div>

        <button type="button" 
                class="w-full py-3 mt-2 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 ease-out hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.5)] hover:-translate-y-0.5 active:translate-y-0 active:scale-95 cursor-pointer" 
                @onclick="HandleRegister">
            INITIALIZE CADET
        </button>
    </div>

    <p class="text-xs mt-6 text-[#8B949E]">
        Already Enrolled?         
        <button type="button" 
                class="text-[#00E5FF] font-semibold hover:underline cursor-pointer transition-colors hover:text-white ml-1" 
                @onclick='() => Nav.NavigateTo("/login")'>
            Return to Log In
        </button>
    </p>
</div>

@code {
    private string name = "";
    private string email = "";
    private string password = "";
    private string role = "STUDENT";
    private string confirmPassword = "";
    private string errorMessage = "";
    private string successMessage = "";

    private async Task HandleRegister()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "All parameters are mandatory.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "Security keys do not match.";
            return;
        }

        var exists = await Db.Users.AnyAsync(u => u.Email.ToLower() == email.Trim().ToLower());
        if (exists)
        {
            errorMessage = "An agent with this email address already exists.";
            return;
        }

        try
        {
            var newUser = new User
            {
                Name = name.Trim(),
                Email = email.Trim().ToLower(),
                Password = password,
                Role = role,
                IsActive = 1
            };

            Db.Users.Add(newUser);
            await Db.SaveChangesAsync();

            if (role == "STUDENT")
            {
                var newStudent = new Student
                {
                    StudId = newUser.Uid,
                    Rank = "Novice"
                };
                Db.Students.Add(newStudent);
                await Db.SaveChangesAsync();
            }

            successMessage = "Agent enrolled successfully. Redirecting to HUD...";
            await Task.Delay(1500);
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Initialization failed: {ex.InnerException?.Message ?? ex.Message}";
        }
    }
}
