@page "/play"
@implements IDisposable
@using BitFlipBlazor.Data
@using BitFlipBlazor.Models
@using BitFlipBlazor.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject UserSession Session
@inject ScoreService ScoreService
@inject NavigationManager Nav

<PageTitle>Simulation Chamber | Bit-Flip Academy</PageTitle>

<div class="max-w-[900px] mx-auto my-10 p-8 bg-[#0D1117] text-white">
    <!-- TOP STATUS -->
    <div class="flex justify-between items-center border-b border-[#30363d] pb-5 mb-8">
        <div>
            <h2 class="text-xl font-bold tracking-tight text-white uppercase">MISSION SIMULATION</h2>
            <p class="text-[#8B949E] text-xs mt-1 font-mono">
                OPERATIVE: @Session.Name | CATEGORY: @(challenge?.Category ?? "UNKNOWN")
            </p>
        </div>
        <div class="flex items-center gap-4">
            <div class="font-mono text-xl font-bold px-4 py-1.5 rounded-lg border 
                        @(timeLeft <= 10 ? "text-red-400 border-red-500 animate-pulse bg-red-950/20" : "text-emerald-400 border-[#30363d] bg-[#161B22]")">
                ⏱ @(timeLeft)s
            </div>
            <button type="button" 
                    class="px-4 py-2 bg-red-950 text-red-400 border border-red-500 text-xs font-bold rounded-lg transition-all hover:bg-red-900 active:scale-95 cursor-pointer" 
                    @onclick="AbortMission">
                ABORT
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-[#161B22] border border-[#30363d] rounded-xl text-center p-14 shadow-lg">
            <p class="text-[#8B949E] text-sm tracking-wider font-mono animate-pulse">INITIALIZING QUANTUM REGISTERS...</p>
        </div>
    }
    else if (challenge == null)
    {
        <div class="bg-[#161B22] border border-[#30363d] rounded-xl text-center p-12 shadow-lg">
            <p class="text-red-400 font-bold mb-4">MISSION DATA CORRUPTED OR NOT FOUND.</p>
            <button type="button" 
                    class="px-5 py-2.5 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all hover:bg-[#00f2ff] cursor-pointer" 
                    @onclick="AbortMission">
                RETURN TO HUD
            </button>
        </div>
    }
    else if (isFinished)
    {
        <!-- RESULT SCREEN -->
        <div class="bg-[#161B22] border border-[#30363d] rounded-xl text-center p-12 shadow-2xl">
            <h1 class="text-3xl font-extrabold tracking-tight mb-2 @(isPassed ? "text-[#00E5FF]" : "text-red-500")">
                @(isPassed ? "MISSION ACCOMPLISHED" : "OPERATION FAILED")
            </h1>
            <p class="text-[#8B949E] text-sm mb-8">
                @(isPassed ? "Target binary configuration matched successfully." : "Time expired or incorrect register states.")
            </p>

            <div class="flex justify-center gap-6 mb-8">
                <div class="w-24 h-24 rounded-full border-2 border-[#00E5FF] flex flex-col items-center justify-center bg-[#00E5FF]/10 shadow-[0_0_15px_rgba(0,229,255,0.2)]">
                    <span class="text-[10px] text-[#8B949E] font-bold">SCORE</span>
                    <b class="text-xl text-[#00E5FF]">@finalScore / 400</b>
                </div>
                <div class="w-24 h-24 rounded-full border-2 border-[#30363d] flex flex-col items-center justify-center bg-[#1c2128]">
                    <span class="text-[10px] text-[#8B949E] font-bold">TIME</span>
                    <b class="text-xl text-white font-mono">@(timeTaken)s</b>
                </div>
            </div>

            <button type="button" 
                    class="w-64 py-3 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-xs rounded-lg transition-all duration-300 hover:bg-[#00f2ff] hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] active:scale-95 cursor-pointer" 
                    @onclick="AbortMission">
                BACK TO DASHBOARD
            </button>
        </div>
    }
    else
    {
        <!-- ACTIVE GAMEPLAY -->
        <div class="text-center bg-[#00E5FF]/5 border-2 border-[#00E5FF] rounded-xl p-6 mb-8 shadow-[0_0_20px_rgba(0,229,255,0.15)]">
            <span class="text-[#8B949E] text-xs font-bold tracking-widest uppercase">TARGET DECIMAL</span>
            <div class="text-6xl font-black font-mono tracking-widest text-[#00E5FF] my-2">@challenge.TargetNumber</div>
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase bg-[#00E5FF]/20 text-[#00E5FF] border border-[#00E5FF]/40">
                @challenge.DifficultyLevel
            </span>
        </div>

        <div class="flex justify-center gap-3 mb-8 flex-wrap">
            @for (int i = 0; i < 8; i++)
            {
                var bitIndex = i;
                var weight = 1 << (7 - bitIndex);
                <div class="flex flex-col items-center w-20">
                    <span class="text-xs text-[#8B949E] font-mono mb-2">@weight</span>
                    <button type="button" 
                            class="w-20 h-24 font-mono font-bold text-3xl rounded-xl border-2 transition-all duration-200 ease-in-out cursor-pointer active:scale-90
                                   @(bits[bitIndex] 
                                       ? "bg-[#00E5FF]/20 text-[#00E5FF] border-[#00E5FF] shadow-[0_0_15px_rgba(0,229,255,0.3)] -translate-y-1" 
                                       : "bg-[#161B22] text-[#8B949E] border-[#30363d] hover:border-gray-500")" 
                            @onclick="() => ToggleBit(bitIndex)">
                        @(bits[bitIndex] ? "1" : "0")
                    </button>
                </div>
            }
        </div>

        <div class="flex justify-between items-center bg-[#1c2128] border border-[#30363d] rounded-lg px-6 py-4 mb-8 text-base">
            <span class="font-mono">CURRENT SUM: <b class="@(currentSum == challenge.TargetNumber ? "text-emerald-400" : "text-white")">@currentSum</b></span>
            <span class="font-mono text-sm text-[#8B949E]">BINARY: <code class="text-[#00E5FF] font-bold">@CurrentBinaryString</code></span>
        </div>

        <button type="button" 
                class="w-full py-4 bg-[#00E5FF] text-black font-bold uppercase tracking-wider text-sm rounded-lg transition-all duration-300 ease-out hover:bg-[#00f2ff] hover:shadow-[0_0_20px_rgba(0,229,255,0.5)] hover:-translate-y-0.5 active:translate-y-0 active:scale-95 cursor-pointer" 
                @onclick="SubmitRegisters">
            SUBMIT CONFIGURATION
        </button>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int? ChallengeId { get; set; }

    private Challenge? challenge;
    private bool isLoading = true;
    private bool isFinished = false;
    private bool isPassed = false;
    private int finalScore = 0;
    private int timeLeft = 30;
    private int timeTaken = 0;

    private bool[] bits = new bool[8];
    private System.Threading.Timer? countdownTimer;

    private int currentSum => bits.Select((b, idx) => b ? (1 << (7 - idx)) : 0).Sum();
    private string CurrentBinaryString => string.Concat(bits.Select(b => b ? "1" : "0"));

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsAuthenticated) return;

        if (!ChallengeId.HasValue)
        {
            isLoading = false;
            return;
        }

        challenge = await Db.Challenges.FirstOrDefaultAsync(c => c.Cid == ChallengeId.Value);
        if (challenge != null)
        {
            timeLeft = challenge.TimeLimit;
            StartTimer();
        }

        isLoading = false;
    }

    private void StartTimer()
    {
        countdownTimer = new System.Threading.Timer(async _ =>
        {
            if (timeLeft > 0 && !isFinished)
            {
                timeLeft--;
                timeTaken++;
                await InvokeAsync(StateHasChanged);
            }
            else if (timeLeft <= 0 && !isFinished)
            {
                await InvokeAsync(async () => await EndGame(false));
            }
        }, null, 1000, 1000);
    }

    private void ToggleBit(int index)
    {
        if (isFinished) return;
        bits[index] = !bits[index];
    }

    private async Task SubmitRegisters()
    {
        if (challenge == null || isFinished) return;

        bool success = currentSum == challenge.TargetNumber;
        await EndGame(success);
    }

    private async Task EndGame(bool passed)
    {
        isFinished = true;
        isPassed = passed;
        countdownTimer?.Dispose();

        if (passed && challenge != null)
        {
            double timeRatio = (double)timeLeft / challenge.TimeLimit;
            finalScore = 200 + (int)Math.Round(timeRatio * 200);
        }
        else
        {
            finalScore = 0;
        }

        if (challenge != null)
        {
            await ScoreService.SaveScoreAsync(
                Session.Uid, 
                challenge.Cid, 
                finalScore, 
                isPassed ? 1 : 0, 
                timeTaken
            );
        }

        await InvokeAsync(StateHasChanged);
    }

    private void AbortMission()
    {
        countdownTimer?.Dispose();
        Nav.NavigateTo("dashboard?view=main");
    }

    public void Dispose()
    {
        countdownTimer?.Dispose();
    }
}
